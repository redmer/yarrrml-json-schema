{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$comment": "Abbreviations are kept next to their full equivalents, with a $ref to that equivalent.",
	"title": "YARRML (RML in YAML)",
	"type": "object",
	"allOf": [{ "$ref": "#/$defs/IDocument" }],
	"$defs": {
		"TermType": { "type": "string", "enum": ["iri", "blank", "literal"] },
		"IDocument": {
			"type": "object",
			"properties": {
				"authors": { "$ref": "#/$defs/IDocumentKeyAuthors" },
				"base": { "$ref": "#/$defs/IDocumentKeyBase" },
				"external": {
					"type": "object",
					"title": "References that do not refer to data in a data source."
				},
				"mappings": { "$ref": "#/$defs/IDocumentMappings" },
				"prefixes": { "$ref": "#/$defs/IDocumentPrefixes" },
				"sources": { "$ref": "#/$defs/IDocumentSources" },
				"targets": { "$ref": "#/$defs/IDocumentTargets" }
			},
			"patternProperties": {
				"^(a|author)$": { "$ref": "#/$defs/IDocument/properties/authors" },
				"^(m|mapping)$": { "$ref": "#/$defs/IDocument/properties/mappings" },
				"^(s|source)$": { "$ref": "#/$defs/IDocument/properties/sources" },
				"^(t|target)$": { "$ref": "#/$defs/IDocument/properties/targets" }
			}
		},
		"IDocumentMappings": {
			"type": "object",
			"title": "A mapping. Each mapping is added to this collection via key-value pair. The key is unique for each mapping. The value is collection containing rules to generate the subjects, predicates, and objects.",
			"description": "https://rml.io/yarrrml/spec/#mappings",
			"patternProperties": {
				"^\\S+$": { "anyOf": [{ "$ref": "#/$defs/Mapping" }] }
			}
		},
		"IDocumentTargets": {
			"type": "object",
			"title": "Output targets\n<https://rml.io/yarrrml/spec/#targets>",
			"patternProperties": {
				"^[A-Za-z_][A-Za-z0-9_-]*$": {
					"anyOf": [{ "$ref": "#/$defs/TargetAbbr" }, { "$ref": "#/$defs/TargetCx" }]
				}
			}
		},
		"IDocumentSources": {
			"type": "object",
			"title": "Data sources",
			"patternProperties": {
				"^\\S+$": {
					"anyOf": [{ "$ref": "#/$defs/SourceCx" }, { "$ref": "#/$defs/SourceAbbr" }]
				}
			}
		},
		"IDocumentKeyAuthors": {
			"title": "The authors of the YARRRML rules.",
			"description": "https://rml.io/yarrrml/spec/#authors",
			"oneOf": [
				{ "$ref": "#/$defs/Author" },
				{ "type": "array", "items": { "$ref": "#/$defs/Author" } }
			]
		},
		"IDocumentKeyBase": {
			"type": "string",
			"format": "uri",
			"title": "Base URI, used for the creation of the IRIs of the term maps and sources of the [R2]RML rules.",
			"description": "https://rml.io/yarrrml/spec/#base-iri"
		},
		"IDocumentPrefixes": {
			"type": "object",
			"title": "Custom namespace prefixes. All of RDFa's prefixes are predefined.",
			"description": "https://rml.io/yarrrml/spec/#prefixes-and-namespaces",
			"patternProperties": { "^\\S+$": { "type": "string", "format": "uri" } }
		},
		"Mapping": {
			"type": "object",
			"properties": {
				"subjects": {
					"anyOf": [
						{ "type": "string" },
						{ "$ref": "#/$defs/SubjectCx" },
						{
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "$ref": "#/$defs/SubjectCx" }]
							}
						}
					]
				},
				"sources": {
					"anyOf": [
						{ "$ref": "#/$defs/SourceCx" },
						{ "$ref": "#/$defs/SourceAbbr" },
						{ "type": "string", "description": "Key of #/sources" },
						{
							"type": "array",
							"items": {
								"anyOf": [
									{ "$ref": "#/$defs/SourceCx" },
									{ "$ref": "#/$defs/SourceAbbr" },
									{ "type": "string", "description": "Key of #/sources" }
								]
							}
						}
					]
				},
				"predicateobjects": {
					"title": "Generates combinations of predicates and objects",
					"type": "array",
					"items": {
						"anyOf": [
							{ "$ref": "#/$defs/PredObjCx" },
							{ "$ref": "#/$defs/PredObjAbbr" },
							{
								"type": "array",
								"items": {
									"anyOf": [{ "$ref": "#/$defs/PredObjCx" }, { "$ref": "#/$defs/PredObjAbbr" }]
								}
							}
						]
					}
				},
				"graphs": {
					"anyOf": [
						{ "type": "string" },
						{ "$ref": "#/$defs/Graph" },
						{
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "$ref": "#/$defs/Graph" }]
							}
						}
					]
				}
			},
			"patternProperties": {
				"^(source)$": { "$ref": "#/$defs/Mapping/properties/sources" },
				"^(s|subject)$": { "$ref": "#/$defs/Mapping/properties/subjects" },
				"^(po|predicateobject)$": { "$ref": "#/$defs/Mapping/properties/predicateobjects" },
				"^(g|graph)$": { "$ref": "#/$defs/Mapping/properties/graphs" }
			}
		},
		"PredObjCx": {
			"type": "object",
			"description": "Predicate and object",
			"properties": {
				"type": { "$ref": "#/$defs/TermType" },
				"predicates": {
					"anyOf": [
						{ "type": "string" },
						{ "$ref": "#/$defs/Predicate" },
						{
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "$ref": "#/$defs/Predicate" }]
							}
						}
					]
				},
				"objects": {
					"anyOf": [
						{ "type": "string" },
						{ "$ref": "#/$defs/Object" },
						{
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "$ref": "#/$defs/Object" }, { "type": "array" }]
							}
						}
					]
				},
				"graphs": {
					"anyOf": [
						{ "type": "string" },
						{ "$ref": "#/$defs/Graph" },
						{
							"type": "array",
							"items": {
								"anyOf": [{ "type": "string" }, { "$ref": "#/$defs/Graph" }]
							}
						}
					]
				},
				"inversepredicates": {
					"type": "string",
					"title": "Inverse predicate, only valid when the object is an IRI or blank node."
				},
				"conditions": { "$ref": "#/$defs/Condition" }
			},
			"patternProperties": {
				"^(c|condition)$": { "$ref": "#/$defs/PredObjCx/properties/conditions" },
				"^(g|graph)$": { "$ref": "#/$defs/PredObjCx/properties/graphs" },
				"^(iv|inversepredicate)$": {
					"$ref": "#/$defs/PredObjCx/properties/inversepredicates"
				},
				"^(o|object)$": { "$ref": "#/$defs/PredObjCx/properties/objects" },
				"^(p|predicate)$": { "$ref": "#/$defs/PredObjCx/properties/predicates" }
			}
		},
		"PredObjAbbr": {
			"type": "array",
			"minItems": 2,
			"maxItems": 3
		},
		"Predicate": {
			"type": "object",
			"properties": {
				"t": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"target": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"targets": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"value": { "type": "string" }
			},
			"patternProperties": {
				"^(c|condition)$": { "$ref": "#/$defs/PredObjCx/properties/conditions" },
				"^(g|graph)$": { "$ref": "#/$defs/PredObjCx/properties/graphs" },
				"^(iv|inversepredicate)$": {
					"$ref": "#/$defs/PredObjCx/properties/inversepredicates"
				},
				"^(v)$": { "$ref": "#/$defs/Predicate/properties/value" },
				"^(p|predicate)$": { "$ref": "#/$defs/PredObjCx/properties/predicates" }
			}
		},
		"Graph": {
			"type": "object",
			"properties": {
				"t": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"target": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"targets": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"v": { "$ref": "#/$defs/Graph/properties/value" },
				"value": { "type": "string" }
			}
		},
		"Object": {
			"type": "object",
			"properties": {
				"datatype": { "type": "string" },
				"lang": { "type": "string" },
				"type": { "$ref": "#/$defs/TermType" },
				"targets": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"function": { "$ref": "#/$defs/Function" },
				"parameters": { "$ref": "#/$defs/Parameters" },
				"value": { "type": "string" }
			},
			"patternProperties": {
				"^(t|target)$": { "$ref": "#/$defs/Object/properties/targets" },
				"^(f|fn)$": { "$ref": "#/$defs/Object/properties/function" },
				"^(pms)$": { "$ref": "#/$defs/Object/properties/parameters" },
				"^(v)$": { "$ref": "#/$defs/Object/properties/value" }
			}
		},
		"Author": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"name": { "type": "string" },
						"email": { "type": "string", "format": "email" },
						"website": { "type": "string", "format": "uri" }
					}
				},
				{
					"type": "string",
					"title": "Name <email> (website)",
					"pattern": "^[^<(]+( <\\S+>)?( \\(\\S+\\))?$"
				},
				{ "type": "string", "title": "WebID", "format": "uri" }
			]
		},
		"Function": {
			"type": "string",
			"title": "Function",
			"description": "Execute a function. Default functions differ per implementation.\nRMLMapper: <https://rml.io/docs/rmlmapper/default-functions/>."
		},
		"Condition": {
			"type": "object",
			"title": "Condition",
			"description": "Only generate a subject or predicate-object when a condition is fulfilled.",
			"properties": {
				"function": { "$ref": "#/$defs/Function" },
				"parameters": { "$ref": "#/$defs/Parameters" }
			},
			"patternProperties": {
				"^(pms)$": { "$ref": "#/$defs/Condition/properties/parameters" }
			}
		},
		"Parameters": {
			"type": "array",
			"description": "Function parameter: pass values with a value IRI",
			"items": {
				"oneOf": [{ "$ref": "#/$defs/ParametersCx" }, { "$ref": "#/$defs/ParametersAbbr" }]
			}
		},
		"ParametersAbbr": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"items": [
				{ "$ref": "#/$defs/ParametersCx/properties/parameter" },
				{ "$ref": "#/$defs/ParametersCx/properties/value" }
			]
		},
		"ParametersCx": {
			"type": "object",
			"properties": {
				"parameter": { "type": "string", "title": "Parameter name" },
				"value": { "type": "string", "title": "Parameter value" }
			},
			"patternProperties": {
				"^(pm)$": { "$ref": "#/$defs/ParametersCx/properties/parameter" }
			}
		},
		"SourceAbbr": {
			"type": "array",
			"minItems": 1,
			"maxItems": 2,
			"items": [
				{ "type": "string", "title": "Access" },
				{
					"$ref": "#/$defs/SourceCx/properties/iterator",
					"title": "Iterator"
				}
			]
		},
		"SourceCx": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"oracle",
						"mysql",
						"hsql",
						"postgresql",
						"db2",
						"informix",
						"ingres",
						"sapase",
						"sapsqlanywhere",
						"firebird",
						"mssql",
						"mssqlserver",
						"virtuoso",
						"wot",
						"sparql",
						"localfile",
						"remotefile"
					]
				},
				"access": { "type": "string" },
				"queryFormulation": {
					"type": "string",
					"enum": [
						"db2",
						"firebird",
						"hsql",
						"informix",
						"ingres",
						"mssql",
						"mysql",
						"oracle",
						"postgresql",
						"progress",
						"sparql11",
						"sql2008",
						"sql2016",
						"sybasease",
						"sybasesqlanywhere",
						"virtuoso"
					]
				},
				"query": { "type": "string" },
				"referenceFormulation": {
					"type": "string",
					"description": "The inner syntax of $(...).",
					"enum": ["csv", "jsonpath", "xpath", "xquery", "css3"]
				},
				"iterator": { "type": "string" },
				"delimiter": { "type": "string", "default": "," },
				"encoding": { "type": "string", "default": "utf-8" },
				"credentials": {
					"type": "object",
					"properties": {
						"username": { "type": "string" },
						"password": { "type": "string" }
					},
					"required": ["username", "password"]
				},
				"contentType": { "type": "string", "pattern": "\\w+/[-+.\\w]+" },
				"operationType": { "type": "string", "enum": ["read", "write"] },
				"security": {
					"anyOf": [
						{ "$ref": "#/$defs/SecurityCx" },
						{ "const": "none" },
						{
							"type": "array",
							"items": { "$ref": "#/$defs/SecurityCx" }
						}
					]
				}
			}
		},
		"SecurityCx": {
			"type": "object",
			"title": "Security",
			"description": "How authentication should be performed againast a Web API or stream when accessing its data.",
			"properties": {
				"type": { "enum": ["apikey", "none"] },
				"in": { "type": "string" },
				"name": { "type": "string" },
				"value": { "type": "string" }
			}
		},
		"TargetAbbr": {
			"oneOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"minLength": 1,
					"maxLength": 3,
					"items": [
						{ "type": "string", "description": "access~type" },
						{ "$ref": "#/$defs/TargetCx/properties/serialization" },
						{ "$ref": "#/$defs/TargetCx/properties/compression" }
					]
				}
			]
		},
		"TargetCx": {
			"type": "object",
			"title": "Logical target",
			"description": "Describes how the generated triples are exported",
			"properties": {
				"type": {
					"type": "string",
					"enum": ["sparql", "localfile", "sd", "void", "dcat"]
				},
				"access": { "type": "string" },
				"serialization": {
					"type": "string",
					"default": "nquads",
					"enum": [
						"jsonld",
						"n3",
						"ntriples",
						"nquads",
						"ldpatch",
						"microdata",
						"owlxml",
						"owlfunctional",
						"owlmanchester",
						"powder",
						"powder-s",
						"prov-n",
						"prov-xml",
						"rdfa",
						"rdfjson",
						"rdfxml",
						"rifxml",
						"sparqlxml",
						"sparqljson",
						"sparqlcsv",
						"sparqltsv",
						"turtle",
						"trig"
					]
				},
				"compression": {
					"type": "string",
					"default": null,
					"enum": ["gzip", "zip", "targzip", "tarxz"]
				}
			}
		},
		"SubjectCx": {
			"type": "object",
			"properties": {
				"value": { "type": "string" },
				"targets": { "$ref": "#/$defs/TargetInline" }
			},
			"patternProperties": {
				"^(t|target)$": { "$ref": "#/$defs/SubjectCx/properties/targets" },
				"^(v)$": { "$ref": "#/$defs/SubjectCx/properties/value" }
			}
		},
		"TargetInline": {
			"title": "Target",
			"anyOf": [
				{ "$ref": "#/$defs/TargetCx" },
				{ "$ref": "#/$defs/TargetAbbr" },
				{ "type": "string", "title": "Key from `#/targets:`" },
				{
					"type": "array",
					"items": {
						"anyOf": [
							{ "$ref": "#/$defs/TargetCx" },
							{ "$ref": "#/$defs/TargetAbbr" },
							{ "type": "string", "title": "Key from `#/targets:`" }
						]
					}
				}
			]
		}
	}
}
