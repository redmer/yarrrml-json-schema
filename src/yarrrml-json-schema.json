{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$comment": "Abbreviations are kept next to their full equivalents, with a $ref to that equivalent.",
	"title": "YARRRML (RML in YAML)",
	"type": "object",
	"allOf": [{ "$ref": "#/definitions/IDocument" }],
	"definitions": {
		"TermType": { "type": "string", "enum": ["iri", "blank", "literal"] },
		"IDocument": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"authentications": { "$ref": "#/definitions/AuthenticationsMap" },
				"authors": { "$ref": "#/definitions/Authors1N" },
				"base": { "$ref": "#/definitions/Base" },
				"external": {
					"type": "object",
					"title": "Static data",
					"description": "References that do not refer to data in a data source. Refer to with <code>$(_key)</code>."
				},
				"mappings": { "$ref": "#/definitions/DocumentMappings" },
				"prefixes": { "$ref": "#/definitions/PrefixObj" },
				"sources": { "$ref": "#/definitions/DocumentSources" },
				"targets": { "$ref": "#/definitions/DocumentTargets" }
			},
			"patternProperties": {
				"^(a|author)$": { "$ref": "#/definitions/IDocument/properties/authors" },
				"^(m|mapping)$": { "$ref": "#/definitions/IDocument/properties/mappings" },
				"^(s|source)$": { "$ref": "#/definitions/IDocument/properties/sources" },
				"^(t|target)$": { "$ref": "#/definitions/IDocument/properties/targets" }
			}
		},
		"DocumentMappings": {
			"type": "object",
			"additionalProperties": false,
			"title": "Mapping that generates triples",
			"description": "Each key must be unique for each mapping\nhttps://rml.io/yarrrml/spec/#mappings",
			"patternProperties": {
				"^\\S+$": { "$ref": "#/definitions/Mapping" }
			}
		},
		"DocumentTargets": {
			"type": "object",
			"additionalProperties": false,
			"title": "Output targets",
			"description": "<https://rml.io/yarrrml/spec/#targets>",
			"patternProperties": {
				"^[A-Za-z_][A-Za-z0-9_-]*$": {
					"oneOf": [
						{ "type": "string" },
						{ "$ref": "#/definitions/TargetAbbr" },
						{ "$ref": "#/definitions/TargetObj" }
					]
				}
			}
		},
		"DocumentSources": {
			"type": "object",
			"additionalProperties": false,
			"title": "Data sources",
			"patternProperties": {
				"^\\S+$": {
					"oneOf": [{ "$ref": "#/definitions/SourceObj" }, { "$ref": "#/definitions/SourceAbbr" }]
				}
			}
		},

		"AuthenticationsMap": {
			"type": "object",
			"title": "Credentials",
			"patternProperties": {
				"^\\S+$": {
					"$ref": "#/definitions/AuthenticationsObj"
				}
			}
		},
		"AuthenticationsObj": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"type": { "type": "string", "enum": ["cssclientcredentials"] },
				"email": { "type": "string" },
				"password": { "type": "string" },
				"oidcIssuer": { "type": "string" },
				"webId": { "type": "string" }
			}
		},

		"Authors1N": {
			"title": "Authors of the YARRRML rules.",
			"oneOf": [
				{ "$ref": "#/definitions/AuthorOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/AuthorOpt" } }
			]
		},
		"AuthorOpt": {
			"oneOf": [
				{ "$ref": "#/definitions/AuthorObj" },
				{ "type": "string", "description": "WebID", "format": "uri", "pattern": "(://|[^\\s])" },
				{
					"type": "string",
					"description": "Name &lt;email&gt; (website)",
					"pattern": "^[^\\(:]+( <\\S+>)?( \\(\\S+\\))?$"
				}
			]
		},
		"AuthorObj": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string" },
				"email": { "type": "string", "format": "email" },
				"website": { "type": "string", "format": "uri" }
			}
		},
		"Base": {
			"type": "string",
			"format": "uri",
			"title": "Base URI",
			"description": "Used for the creation of the IRIs of the term maps and sources of the [R2]RML rules."
		},
		"PrefixObj": {
			"type": "object",
			"additionalProperties": false,
			"title": "Additional prefixes and namespaces.",
			"description": "All of RDFa's prefixes are predefined.\n<https://rml.io/yarrrml/spec/#prefixes-and-namespaces>",
			"patternProperties": {
				"^([A-Za-z]([A-Za-z0-9\\._-]*[A-Za-z0-9_])?|)$": { "type": "string", "format": "uri" }
			}
		},
		"Subject1N": {
			"title": "Subject template",
			"oneOf": [
				{ "const": null },
				{ "$ref": "#/definitions/SubjectOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/SubjectOpt" } }
			]
		},
		"SubjectOpt": {
			"oneOf": [{ "$ref": "#/definitions/SubjectAbbr" }, { "$ref": "#/definitions/SubjectObj" }]
		},
		"SubjectAbbr": { "type": "string" },
		"SubjectObj": {
			"allOf": [
				{ "$ref": "#/definitions/FunctionParamsTargetsValue" },
				{ "$ref": "#/definitions/SubjectObj_" }
			]
		},
		"SubjectObj_": {
			"type": "object",
			"properties": {
				"type": { "$ref": "#/definitions/TermType" }
			}
		},
		"Mapping": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"subjects": { "$ref": "#/definitions/Subject1N" },
				"sources": { "$ref": "#/definitions/Sources1N" },
				"predicateobjects": { "$ref": "#/definitions/PredicateObjects1N" },
				"graphs": { "$ref": "#/definitions/Graphs1N" },
				"condition": { "$ref": "#/definitions/Condition1N" },
				"changeDetection": { "$ref": "#/definitions/ChangeDetectionObj" }
			},
			"patternProperties": {
				"^(source)$": { "$ref": "#/definitions/Mapping/properties/sources" },
				"^(s|subject)$": { "$ref": "#/definitions/Mapping/properties/subjects" },
				"^(po|predicateobject)$": { "$ref": "#/definitions/Mapping/properties/predicateobjects" },
				"^(g|graph)$": { "$ref": "#/definitions/Mapping/properties/graphs" }
			}
		},

		"PredicateObjects1N": {
			"title": "Predicate-object combinations",
			"type": "array",
			"items": { "$ref": "#/definitions/PredicateObjectsOpt" }
		},
		"PredicateObjectsOpt": {
			"oneOf": [
				{ "$ref": "#/definitions/PredicateObjectsAbbr" },
				{ "$ref": "#/definitions/PredicateObjectsObj" }
			]
		},
		"PredicateObjectsAbbr": {
			"type": "array",
			"minItems": 2,
			"maxItems": 3,
			"items": [
				{ "$ref": "#/definitions/PredicateObjectsObj/properties/predicates" },
				{ "$ref": "#/definitions/PredicateObjectsObj/properties/objects" },
				{
					"description": "Literal datatype or language (XX~lang)",
					"oneOf": [
						{ "type": "string", "description": "Literal datatype", "pattern": ":" },
						{ "type": "string", "description": "Literal language", "pattern": "~" }
					]
				}
			]
		},
		"PredicateObjectsObj": {
			"type": "object",
			"additionalProperties": false,
			"description": "Predicate and object",
			"properties": {
				"type": { "$ref": "#/definitions/TermType" },
				"predicates": { "$ref": "#/definitions/Predicate1N" },
				"objects": { "$ref": "#/definitions/Object1N" },
				"graphs": { "$ref": "#/definitions/Graphs1N" },
				"inversepredicates": {
					"$ref": "#/definitions/PredicateObjectsObj/properties/predicates",
					"title": "Inverse predicate, only valid when the object is an IRI or blank node."
				},
				"conditions": { "$ref": "#/definitions/ConditionObj" }
			},
			"patternProperties": {
				"^(c|condition)$": { "$ref": "#/definitions/PredicateObjectsObj/properties/conditions" },
				"^(g|graph)$": { "$ref": "#/definitions/PredicateObjectsObj/properties/graphs" },
				"^(iv|inversepredicate)$": {
					"$ref": "#/definitions/PredicateObjectsObj/properties/inversepredicates"
				},
				"^(o|object)$": { "$ref": "#/definitions/PredicateObjectsObj/properties/objects" },
				"^(p|predicate)$": { "$ref": "#/definitions/PredicateObjectsObj/properties/predicates" }
			}
		},
		"Predicate1N": {
			"title": "Output predicates",
			"oneOf": [
				{ "$ref": "#/definitions/PredicateOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/PredicateOpt" } }
			]
		},
		"PredicateOpt": {
			"oneOf": [{ "$ref": "#/definitions/PredicateAbbr" }, { "$ref": "#/definitions/PredicateObj" }]
		},
		"PredicateAbbr": { "type": "string" },
		"PredicateObj": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"targets": { "$ref": "#/definitions/Targets1N" },
				"value": { "type": "string" }
			},
			"patternProperties": {
				"^(t|target)$": { "$ref": "#/definitions/PredicateObj/properties/targets" }
			}
		},

		"Graphs1N": {
			"oneOf": [
				{ "$ref": "#/definitions/GraphsOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/GraphsOpt" } }
			]
		},
		"GraphsOpt": {
			"oneOf": [{ "$ref": "#/definitions/GraphsAbbr" }, { "$ref": "#/definitions/GraphsObj" }]
		},
		"GraphsAbbr": { "type": "string" },

		"GraphsObj": { "$ref": "#/definitions/FunctionParamsTargetsValue" },

		"Object1N": {
			"title": "Output triple objects",
			"anyOf": [
				{ "$ref": "#/definitions/ObjectOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/ObjectOpt" } }
			]
		},
		"ObjectOpt": {
			"oneOf": [{ "$ref": "#/definitions/ObjectAbbr" }, { "$ref": "#/definitions/ObjectObj" }]
		},
		"ObjectAbbr": {
			"oneOf": [
				{ "type": "string" },
				{ "type": "number" },
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": [
						{ "$ref": "#/definitions/PredicateObjectsObj/properties/objects" },
						{
							"title": "Literal datatype or language (XX~lang)",
							"oneOf": [
								{ "type": "string", "description": "Literal datatype", "pattern": ":" },
								{ "type": "string", "description": "Literal language", "pattern": "~" }
							]
						}
					]
				}
			]
		},
		"ObjectObj": {
			"allOf": [
				{ "$ref": "#/definitions/FunctionParamsTargetsValue" },
				{ "$ref": "#/definitions/ObjectObj_" }
			]
		},
		"ObjectObj_": {
			"type": "object",
			"properties": {
				"datatype": { "type": "string", "description": "Literal datatype" },
				"language": { "$ref": "#/definitions/GraphsOpt" },
				"type": { "$ref": "#/definitions/TermType" },
				"mapping": { "type": "string", "description": "Mapping reference" },
				"condition": { "$ref": "#/definitions/Condition1N" }
			},
			"patternProperties": {
				"^(lang)$": { "$ref": "#/definitions/ObjectObj_/properties/language" }
			}
		},
		"FunctionParamsTargetsValue": {
			"type": "object",
			"properties": {
				"function": { "$ref": "#/definitions/Function" },
				"parameters": { "$ref": "#/definitions/Parameters1N" },
				"targets": { "$ref": "#/definitions/Targets1N" },
				"value": { "type": "string" }
			},
			"patternProperties": {
				"^(f|fn)$": { "$ref": "#/definitions/FunctionParamsTargetsValue/properties/function" },
				"^(pms)$": { "$ref": "#/definitions/FunctionParamsTargetsValue/properties/parameters" },
				"^(t|target)$": { "$ref": "#/definitions/FunctionParamsTargetsValue/properties/targets" },
				"^(v)$": { "$ref": "#/definitions/FunctionParamsTargetsValue/properties/value" }
			}
		},

		"Function": {
			"type": "string",
			"title": "Function",
			"description": "Execute a function. Default functions differ per implementation.\nRMLMapper: <https://rml.io/docs/rmlmapper/default-functions/>."
		},
		"Condition1N": {
			"oneOf": [
				{ "$ref": "#/definitions/ConditionObj" },
				{ "type": "array", "items": { "$ref": "#/definitions/ConditionObj" } }
			]
		},
		"ConditionObj": {
			"type": "object",
			"additionalProperties": false,
			"title": "Condition",
			"description": "Only generate a subject or predicate-object when a condition is fulfilled.",
			"properties": {
				"function": { "$ref": "#/definitions/Function" },
				"parameters": { "$ref": "#/definitions/Parameters1N" }
			},
			"patternProperties": {
				"^(pms)$": { "$ref": "#/definitions/ConditionObj/properties/parameters" }
			}
		},

		"Parameters1N": {
			"oneOf": [
				{ "$ref": "#/definitions/ParametersOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/ParametersOpt" } }
			]
		},
		"ParametersOpt": {
			"type": "array",
			"description": "Function parameter: pass values with a value IRI",
			"items": {
				"oneOf": [
					{ "$ref": "#/definitions/ParametersObj" },
					{ "$ref": "#/definitions/ParametersAbbr" }
				]
			}
		},
		"ParametersAbbr": {
			"type": "array",
			"minItems": 2,
			"maxItems": 3,
			"items": [
				{ "$ref": "#/definitions/ParametersObj/properties/parameter" },
				{ "$ref": "#/definitions/ParametersObj/properties/value" },
				{
					"oneOf": [
						{
							"const": "s",
							"description": "Only for a conditional mapping relationship: the value of this parameter comes from the <em>subject</em>.",
							"default": "s"
						},
						{
							"const": "o",
							"description": "Only for a conditional mapping relationship: the value of this parameter comes from the <em>object</em>."
						}
					]
				}
			]
		},
		"ParametersObj": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"parameter": { "type": "string", "title": "Parameter name" },
				"value": {
					"oneOf": [
						{ "type": "string", "title": "Parameter value" },
						{ "type": "boolean", "title": "Parameter value" },
						{ "type": "number", "title": "Parameter value" },
						{ "$ref": "#/definitions/FunctionParamsTargetsValue" }
					]
				}
			},
			"patternProperties": {
				"^(pm)$": { "$ref": "#/definitions/ParametersObj/properties/parameter" }
			}
		},
		"Sources1N": {
			"title": "Data sources for this mapping",
			"oneOf": [
				{ "$ref": "#/definitions/SourcesOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/SourcesOpt" } }
			]
		},
		"SourcesOpt": {
			"oneOf": [
				{
					"type": "string",
					"description": "Reference to a document-level source"
				},
				{ "$ref": "#/definitions/SourceAbbr" },
				{ "$ref": "#/definitions/SourceObj" }
			]
		},
		"SourceAbbr": {
			"type": "array",
			"minItems": 1,
			"maxItems": 2,
			"items": [
				{ "type": "string", "title": "access~referenceFormulation", "pattern": "~" },
				{
					"$ref": "#/definitions/SourceObj/properties/iterator",
					"title": "Iterator template"
				}
			]
		},
		"HTTPRequestSourceOrTarget": {
			"type": "object",
			"properties": {}
		},
		"HTTPRequestHeader": {
			"type": "object",
			"description": "As a data source, the Accept header is by-default derived from the reference formulation (csv, jsonpath, xpath, xquery).\nAs a target, the Content-Type header is by-default derived from the serialization of the target.",
			"properties": {
				"name": { "type": "string" },
				"value": { "type": "string" }
			}
		},
		"SourceObj": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"oracle",
						"mysql",
						"hsql",
						"postgresql",
						"db2",
						"informix",
						"ingres",
						"sapase",
						"sapsqlanywhere",
						"firebird",
						"mssql",
						"mssqlserver",
						"virtuoso",
						"wot",
						"sparql",
						"localfile",
						"remotefile",
						"directhttprequest",
						"linkedhttprequest"
					]
				},
				"access": { "type": "string" },
				"queryFormulation": {
					"type": "string",
					"enum": [
						"db2",
						"firebird",
						"hsql",
						"informix",
						"ingres",
						"mssql",
						"mysql",
						"oracle",
						"postgresql",
						"progress",
						"sparql11",
						"sql2008",
						"sql2016",
						"sybasease",
						"sybasesqlanywhere",
						"virtuoso"
					]
				},
				"query": { "type": "string" },
				"referenceFormulation": {
					"type": "string",
					"description": "The inner syntax of $(...).",
					"enum": ["csv", "jsonpath", "xpath", "xquery", "css3"]
				},
				"iterator": {
					"type": "string",
					"description": "Template that defines what records are processed. Conforms to reference formulation."
				},
				"delimiter": { "type": "string", "default": ",", "description": "Only for CSV files." },
				"encoding": { "type": "string", "default": "utf-8" },
				"credentials": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"username": { "type": "string" },
						"password": { "type": "string" }
					},
					"required": ["username", "password"]
				},
				"contentType": {
					"type": "string",
					"pattern": "\\w+/[-+.\\w]+",
					"description": "MIME type of the retrieved data."
				},
				"operationType": { "type": "string", "enum": ["read", "write"] },
				"security": { "$ref": "#/definitions/SourceSecurity1N" },
				"methodName": { "type": "string", "default": "GET" },
				"headers": {
					"oneOf": [
						{ "$ref": "#/definitions/HTTPRequestHeader" },
						{ "type": "array", "items": { "$ref": "#/definitions/HTTPRequestHeader" } }
					]
				},
				"rel": { "type": "string" },
				"authentication": { "type": "string", "description": "Key in Authentications" }
			}
		},
		"SourceSecurity1N": {
			"title": "WOT authentication",
			"oneOf": [
				{ "$ref": "#/definitions/SourceSecurityObj" },
				{ "const": "none" },
				{ "type": "array", "items": { "$ref": "#/definitions/SourceSecurityObj" } }
			]
		},
		"SourceSecurityObj": {
			"type": "object",
			"additionalProperties": false,
			"description": "How authentication should be performed against a Web API or stream when accessing its data.",
			"properties": {
				"type": { "enum": ["apikey", "none"] },
				"in": { "type": "string" },
				"name": { "type": "string" },
				"value": { "type": "string" }
			}
		},
		"Targets1N": {
			"anyOf": [
				{ "$ref": "#/definitions/TargetOpt" },
				{ "type": "array", "items": { "$ref": "#/definitions/TargetOpt" } }
			]
		},
		"TargetOpt": {
			"oneOf": [
				{
					"type": "string",
					"description": "Reference to a document-level target",
					"pattern": "[^~]"
				},
				{ "$ref": "#/definitions/TargetAbbr" },
				{ "$ref": "#/definitions/TargetObj" }
			]
		},
		"TargetAbbr": {
			"type": "array",
			"minItems": 1,
			"maxItems": 3,
			"items": [
				{ "type": "string", "description": "access~type" },
				{ "$ref": "#/definitions/TargetObj/properties/serialization" },
				{ "$ref": "#/definitions/TargetObj/properties/compression" }
			]
		},
		"TargetObj": {
			"type": "object",
			"additionalProperties": false,
			"title": "Logical target",
			"description": "Describes how the generated triples are exported",
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"sparql",
						"localfile",
						"sd",
						"void",
						"dcat",
						"directhttprequest",
						"linkedhttprequest"
					]
				},
				"access": { "type": "string" },
				"serialization": {
					"type": "string",
					"default": "nquads",
					"enum": [
						"jsonld",
						"n3",
						"ntriples",
						"nquads",
						"ldpatch",
						"microdata",
						"owlxml",
						"owlfunctional",
						"owlmanchester",
						"powder",
						"powder-s",
						"prov-n",
						"prov-xml",
						"rdfa",
						"rdfjson",
						"rdfxml",
						"rifxml",
						"sparqlxml",
						"sparqljson",
						"sparqlcsv",
						"sparqltsv",
						"turtle",
						"trig"
					]
				},
				"compression": {
					"type": "string",
					"description": "By default, no compression is applied",
					"enum": ["gzip", "zip", "targzip", "tarxz"]
				},
				"ldes": {
					"title": "Extension for Linked Data Event Streams\n<https://rml.io/yarrrml/spec/incrml/>",
					"type": "object",
					"properties": {
						"id": { "type": "string", "description": "EventStream identifier" },
						"timestampPath": { "type": "string", "default": "dcterms:created" },
						"versionOfPath": { "type": "string", "default": "dcterms:isVersionOf" },
						"generateImmutableIRI": {
							"type": "boolean",
							"default": false,
							"description": "Turn the member subject IRI into a unique IRI."
						}
					}
				},
				"security": { "$ref": "#/definitions/SourceSecurity1N" },
				"methodName": { "type": "string", "default": "PUT" },
				"headers": {
					"oneOf": [
						{ "$ref": "#/definitions/HTTPRequestHeader" },
						{ "type": "array", "items": { "$ref": "#/definitions/HTTPRequestHeader" } }
					]
				},
				"rel": { "type": "string" },
				"authentication": { "type": "string", "description": "Key in Authentications" },
				"source": { "type": "string", "description": "Key in Sources" },
				"id": { "type": "string", "description": "Template generating identifiers" }
			}
		},
		"ChangeDetectionObj": {
			"type": "object",
			"title": "Extension for Linked Data Event Streams\n<https://rml.io/yarrrml/spec/incrml/>",
			"description": "Specify what to do when certain changes in data are detected.",
			"properties": {
				"create": {
					"$ref": "#/definitions/ChangeOperationObj",
					"title": "Create when a change is detected"
				},
				"update": {
					"$ref": "#/definitions/ChangeOperationObj",
					"title": "Update when a change is detected"
				},
				"delete": {
					"$ref": "#/definitions/ChangeOperationObj",
					"title": "Delete when a change is detected"
				}
			}
		},
		"ChangeOperationObj": {
			"type": "object",
			"properties": {
				"explicit": {
					"type": "boolean",
					"default": true,
					"description": "Advertised by data source."
				},
				"mappingAdd": {
					"$ref": "#/definitions/Mapping",
					"description": "Things that will be *added to* the current mapping for this operation"
				},
				"mappingRemove": {
					"$ref": "#/definitions/Mapping",
					"description": "Things that will be removed (ignored) from the original mapping"
				},
				"watchedProperties": { "$ref": "#/definitions/WatchedProperties1N" }
			}
		},
		"WatchedProperties1N": {
			"oneOf": [
				{ "$ref": "#/definitions/WatchedProperty" },
				{ "type": "array", "items": { "$ref": "#/definitions/WatchedProperty" } }
			]
		},
		"WatchedProperty": {
			"type": "string",
			"description": "Data attributes that trigger an update when they change.",
			"examples": ["watchedProperties: [$(temperature)]"]
		}
	}
}
